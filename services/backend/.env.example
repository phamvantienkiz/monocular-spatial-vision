# Environment variables for Monocular Spatial Backend
ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Networking & Ingest
INGEST_PORT=9876
RING_BUFFER_SIZE=5

# Models & Weights
MODEL_ENGINE_PATH=weights/yolov8n-seg.engine
MODEL_ONNX_PATH=weights/yolov8n-seg.onnx
CONFIDENCE_THRESHOLD=0.50

# Hardware & Calibration
CALIB_CONFIG_PATH=configs/calib_pcam5c.yaml
ENABLE_IMU_TILT_COMPENSATION=true
